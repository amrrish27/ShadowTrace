# ShadowTrace configuration reference.
#
# This file mirrors `backend/app/config.py` exactly: every ST_* variable the code reads
# appears here, and nothing else does. `backend/tests/test_env_example.py` fails if the
# two drift apart, or if a published default stops matching the code.
#
# Values are the code defaults, except ST_ENV: this file is a *deployment* template
# (deploy/compose.yaml consumes it), so it starts in production, where the fail-closed
# checks below actually apply.
#
# Copy to .env and change every value marked CHANGE-ME before deploying.

# --- core -------------------------------------------------------------------
ST_ENV=production                     # production | development | test
ST_SECRET_KEY=CHANGE-ME-64-random-chars
ST_DATABASE_PATH=/data/shadowtrace.db
ST_BASE_URL=http://localhost:8000
ST_ALLOWED_HOSTS=localhost,127.0.0.1
ST_CORS_ORIGINS=http://localhost:8000
ST_LOG_LEVEL=INFO

# --- sessions ---------------------------------------------------------------
ST_COOKIE_SECURE=true                 # forced on in production; set false only for local http
ST_SESSION_IDLE_SECONDS=1800
ST_SESSION_ABSOLUTE_SECONDS=43200

# --- reverse proxy ----------------------------------------------------------
# Only these peers may set X-Forwarded-For; a literal address or a CIDR network.
# In compose the proxy is pinned to 172.30.0.2 on the backend network — keep this equal
# to uvicorn's --forwarded-allow-ips (the Dockerfile reads this variable for it).
# Never widen this to a value an untrusted client can reach.
ST_TRUSTED_PROXIES=172.30.0.2

# --- scanning safety --------------------------------------------------------
# Kill switch: "false" blocks scan creation AND every outbound request.
# (The unprefixed SCANNING_ENABLED is accepted as a deprecated fallback.)
ST_SCANNING_ENABLED=true
# The ONLY hosts allowed in private address space. Every entry is an exact
# host:port pair. Leave empty in production; add "127.0.0.1:8099" for the lab.
ST_PRIVATE_ALLOWLIST=
# --- bundled training lab (ShadowLab) --------------------------------------
# Enables the Lab page and its control API. Defaults to true unless ST_ENV=production
# (where the lab is refused outright, whatever this is set to).
ST_LAB_ENABLED=true
# The lab binds to a loopback address only; a non-loopback value fails startup.
ST_LAB_HOST=127.0.0.1
ST_LAB_PORT=8099
# Start the lab process automatically when the API starts (the Lab page can also
# start/stop/restart it, and `make lab` / start.cmd run it on its own).
ST_LAB_AUTOSTART=false

# Hard ceilings. Per-scan values in the API cannot exceed these.
ST_MAX_REQUESTS_HARD_CAP=2000
ST_MAX_PAGES_HARD_CAP=200
ST_MAX_SCAN_SECONDS_HARD_CAP=900
ST_MAX_RESPONSE_BYTES=2097152          # 2 MiB, the largest body the scanner will read
ST_MAX_UPLOAD_BYTES=8388608            # 8 MiB, the largest HAR/spec upload accepted

# --- quotas and scheduling --------------------------------------------------
ST_SCAN_CONCURRENCY_PER_ORG=2
ST_SCANS_PER_DAY_PER_ORG=50
ST_WORKER_POLL_MS=500                  # worker claim poll interval, milliseconds
ST_WORKER_LEASE_SECONDS=30
ST_RETENTION_DAYS=90

# --- demo -------------------------------------------------------------------
# Refused in production. Enables the read-only sample data path in the UI.
ST_DEMO_MODE=false

# --- bootstrap (first run only; remove afterwards) --------------------------
ST_BOOTSTRAP_ADMIN_EMAIL=
ST_BOOTSTRAP_ADMIN_PASSWORD=
ST_BOOTSTRAP_ORG_NAME=ShadowTrace Demo
