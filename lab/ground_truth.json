  "traps": [
    {
      "path": "/redirect-metadata",
      "expected": "blocked, not followed"
    },
    {
      "path": "/redirect-loopback",
      "expected": "blocked, not followed"
    },
    {
      "path": "/redirect-loop",
      "expected": "blocked after hop limit"
    },
    {
      "path": "/redirect-cross-origin",
      "expected": "blocked"
    },
    {
      "path": "/bomb.gz",
      "expected": "response size aborted"
    },
    {
      "path": "/endless",
      "expected": "response size aborted"
    },
    {
      "path": "/huge-headers",
      "expected": "header limits enforced"
    },
    {
      "path": "/big.js",
      "expected": "response size aborted"
    },
    {
      "path": "/nested.json",
      "expected": "nesting rejected"
    },
    {
      "path": "/spec-remote-ref.json",
      "expected": "remote $ref refused"
    },
    {
      "path": "/sitemap-bomb.xml",
      "expected": "entity expansion refused"
    },
    {
      "path": "/slow",
      "expected": "timeout enforced"
    }
  ],
  "by_design_absent": [
    {
      "rule": "ST-022",
      "scenario": "open-redirect",
      "reason": "The lab honours only same-site redirect targets and answers an absolute URL with 400, so an off-site Location can never be produced. Proving ST-022 requires a target the operator does not control."
    }
  ]
