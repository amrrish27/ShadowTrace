  "negative_controls": [
    {
      "path": "/api/v2/secure",
      "expect": "no finding",
      "reason": "correctly secured endpoint answers 401"
    },
    {
      "path": "/api/v1/health",
      "expect": "no finding",
      "reason": "clean documented endpoint"
    },
    {
      "path": "/api/v1/decoy-only-in-comment",
      "expect": "not discovered",
      "reason": "endpoint string lives in an HTML comment"
    },
    {
      "path": "/api/v1/decoy-in-prose",
      "expect": "no finding",
      "reason": "prose decoy resolves to the SPA catch-all (soft-404)"
    },
    {
      "path": "/does-not-exist-*",
      "expect": "not reported as live",
      "reason": "SPA catch-all 200 is fingerprinted"
    }
